# ─────────────────────────────────────────────────────────────
# Nestora · Storefront (application étudiante)
# Copie ce fichier en .env.local puis remplis les valeurs.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role : serveur uniquement (connexion par téléphone, contrôle du numéro à l'inscription).
# Ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URLs publiques (redirections email / OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BACKOFFICE_URL=http://localhost:3001

# ── Code de vérification par email (OTP) ─────────────────────
# Doivent correspondre à Supabase → Authentication → Providers → Email
# (Email OTP Length / Email OTP Expiration) ou à supabase/config.toml.
NEXT_PUBLIC_OTP_LENGTH=8
NEXT_PUBLIC_OTP_EXPIRY_SECONDS=600
NEXT_PUBLIC_OTP_RESEND_SECONDS=60

# ── SMTP utilisé par Supabase Auth pour envoyer le code ──────
# Local : lu par supabase/config.toml (supabase start).
# Hébergé : à recopier dans Authentication → Emails → SMTP Settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Nestora
